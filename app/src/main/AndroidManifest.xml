<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AudoibooApp"
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:label="Audoiboo Tracker"
        android:icon="@drawable/ic_launcher_audoiboo"
        android:roundIcon="@drawable/ic_launcher_audoiboo"
        android:theme="@style/Theme.AudoibooTracker">

        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <receiver android:name=".ContinueListeningWidget" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/continue_listening_widget_info" />
        </receiver>
        <receiver android:name=".DownloadRecoveryReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <service android:name=".ManagedDownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".SleepTimerService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".PlaybackService" android:exported="true" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaLibraryService" /><action android:name="android.media.browse.MediaBrowserService" /></intent-filter>
        </service>
        <activity android:name=".DiagnosticActivity" android:exported="false" android:label="Audoiboo DOM" />
        <activity android:name=".CatalogDiagnosticsActivity" android:exported="false" android:label="Діагностика каталогу" />
        <activity android:name=".SeriesLogActivity" android:exported="false" android:label="Лог пошуку серій" />
        <activity android:name=".PluginDiagnosticsActivity" android:exported="false" android:label="Діагностика плагіна" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="Налаштування" />
        <activity android:name=".PluginManagementActivity" android:exported="false" android:label="Плагіни джерел" />
        <activity android:name=".PlayerSettingsActivity" android:exported="false" android:label="Налаштування плеєра" />
        <activity android:name=".SleepTimerActivity" android:exported="false" android:label="Таймер сну" />
        <activity android:name=".ListeningStatsActivity" android:exported="false" android:label="Статистика прослуховування" />
        <activity android:name=".QueueEditorActivity" android:exported="false" android:label="Черга прослуховування" />
        <activity android:name=".SeriesPlaybackSettingsActivity" android:exported="false" android:label="Швидкість за серіями" />
        <activity android:name=".PlayerActivity" android:exported="false" android:label="Плеєр" />
        <activity android:name=".ManualDownloadActivity" android:exported="false" android:label="Ручне додавання архіву" />
        <activity android:name=".LibraryToolsActivity" android:exported="false" android:label="Інструменти бібліотеки" />
        <activity android:name=".CatalogDiscoveryActivity" android:exported="false" android:label="Каталог авторів" />
        <activity android:name=".MainActivity" android:exported="false" android:label="Керування Audioboo" />
        <activity android:name=".RoomLibraryActivity" android:exported="true" android:label="Audoiboo Tracker">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
