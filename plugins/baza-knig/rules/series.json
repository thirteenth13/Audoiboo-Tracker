{
  "operation": "seriesLookup",
  "series": {
    "title": "meta[property='og:title']@content || title || h1 || a[href*='/series-']",
    "titleRegex": "(?i)^\\s*(?:аудиокниги\\s+серии\\s*[«\"“]?|серия\\s*:?)?\\s*[«\"“]?(.+?)[»\"”]?\\s*(?:\\([0-9]+\\))?\\s*(?:слушать\\s+онлайн)?(?:\\s*[-|]\\s*Baza-Knig.*)?\\s*$",
    "followLink": "a[href*='/series-']@href || a[href*='/xfsearch/cikl/']@href",
    "description": "meta[name='description']@content",
    "books": {
      "item": "a[href*='/audio-']",
      "title": "@text",
      "link": "@href"
    },
    "supplement": {
      "startLink": "a[href*='/avtor-']@href || a[href*='/xfsearch/autor/']@href",
      "maxPages": 5,
      "nextPage": "a[rel='next']@href || .navigation a.next@href",
      "seriesTitle": "a[href*='/series-'] || a[href*='/xfsearch/cikl/']",
      "items": {
        "item": "a[href*='/audio-']",
        "title": "@text",
        "link": "@href"
      }
    }
  }
}
