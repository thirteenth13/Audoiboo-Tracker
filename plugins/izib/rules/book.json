{
  "operation": "bookLookup",
  "book": {
    "title": "h1, .book-title, .title",
    "author": "a[href*='/author']:not([href='/authors']):not([href$='/authors']) || a[href*='/avtor/']",
    "seriesTitle": "a[href*='/serie'], a[href*='/series']",
    "coverUrl": "meta[property='og:image']@content",
    "description": "meta[name='description']@content"
  }
}
