{
  "id": "knigavuhe",
  "name": "Knigavuhe",
  "version": 1,
  "apiVersion": 1,
  "runtime": "DECLARATIVE",
  "hosts": [
    "knigavuhe.org",
    "m.knigavuhe.org"
  ],
  "capabilities": [
    "BOOK_LOOKUP",
    "DOWNLOAD_RESOLUTION"
  ],
  "permissions": {
    "networkHosts": [
      "knigavuhe.org",
      "m.knigavuhe.org"
    ],
    "downloadHosts": [
      "knigavuhe.org"
    ],
    "cookies": false,
    "javascript": false
  },
  "entrypoints": {
    "bookLookup": "rules/book.json",
    "downloadResolution": "rules/download.json"
  }
}
