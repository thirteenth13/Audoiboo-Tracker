{
  "operation": "seriesLookup",
  "series": {
    "title": "title || h1",
    "titleRegex": "(?i)^(?:цикл\\s*[«\"“]?)?(.+?)(?:[»\"”]?\\s*[-—]\\s*слушать.*|[»\"”]?\\s+автор\\b|[»\"”]?\\s*$)",
    "followLink": "a[href*='/serie/']@href || a[href*='/series/']@href",
    "books": {
      "item": "a[href*='/book/']",
      "title": "@text",
      "link": "@href",
      "author": "a[href*='/author/']"
    }
  }
}
