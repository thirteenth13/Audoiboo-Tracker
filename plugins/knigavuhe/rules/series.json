{
  "operation": "seriesLookup",
  "series": {
    "title": "meta[property='og:title']@content",
    "titleRegex": "(?i)^\\s*цикл\\s+(.+?)\\s*(?:-|—)\\s*слушать\\s+онлайн.*$",
    "followLink": "a[href*='/series/']@href || a[href*='/serie/']@href",
    "books": {
      "item": "a[href*='/book/']",
      "title": "@text",
      "link": "@href",
      "author": "a[href*='/author/']"
    }
  }
}
